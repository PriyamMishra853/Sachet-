# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Every key is optional locally: without it, that feature uses an in-memory
# stand-in or is switched off.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Long random string: `openssl rand -hex 32`. Required in production (32+ characters).
# Never change it after launch: report counting depends on it.
HASH_SALT=

# Supabase > Project settings > Database > Connection string (Session pooler)
DATABASE_URL=
# Optional: Supabase > Database settings > SSL Configuration > Download certificate.
# Paste the PEM (or its base64) so the API verifies it really talks to Supabase.
DATABASE_CA_CERT=
# Upstash > Redis database > TCP connection string (rediss://...)
REDIS_URL=
# Google Cloud > APIs & Services > Credentials (Safe Browsing API enabled)
SAFE_BROWSING_API_KEY=

# From @BotFather. Leave TELEGRAM_WEBHOOK_SECRET empty locally to use polling;
# in production use `openssl rand -hex 24` (24+ letters/digits).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Meta developer app > WhatsApp > API setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# 16+ characters you make up; you type the same value into Meta's dashboard.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Web app origins allowed to call the API (comma-separated; * is refused in production)
CORS_ORIGINS=http://localhost:3001
# Proxies in front of the API. Default 1 in production (Railway/Render), 0 locally.
TRUST_PROXY_HOPS=
