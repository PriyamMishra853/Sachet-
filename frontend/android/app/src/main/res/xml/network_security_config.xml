<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, and only certificates the phone already trusts (no user-added ones,
     so a certificate installed by malware or a work profile can't read the traffic). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
